// prisma/schema.prisma
// Kein eigener migrations-Ordner - wie bei rsvp-app ausschließlich per
// `npx prisma db push` synchronisiert (siehe README.md/Dockerfile).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ADMIN sieht/verwaltet alle Abstimmungen und Konten. CREATOR legt eigene Abstimmungen
// an, verwaltet sie und teilt sie mit anderen Konten. MODERATOR legt keine eigenen
// Abstimmungen an, sondern bearbeitet/schließt ausschließlich per PollAccess geteilte.
// Gleiche Rollen wie in rsvp-app, aber bewusst eigenständig vergeben - siehe README
// "Konten" und suite-kit für die optionale Anmeldung mit Konten anderer Tools.
enum Role {
  ADMIN
  CREATOR
  MODERATOR
}

// Ein lokales Konto dieses Tools. Registrierung ist nicht öffentlich: Konten legt ein
// eingeloggter Nutzer an (Einladungslink, siehe resetTokenHash) oder sie entstehen beim
// ersten Login über ein verbundenes Tool (ExternalIdentity, nur wenn SUITE_IDPS das
// erlaubt). passwordHash ist null bei rein föderierten Konten und bei noch nicht
// angenommenen Einladungen - beides kann sich nur nicht per Passwort anmelden.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(CREATOR)
  createdAt    DateTime @default(now())
  // Zuletzt bei einer Anmeldung gesetzt (Passwort UND Verbund-Login, siehe issueSession in
  // app/lib/auth.ts). Grundlage für die automatische Löschung inaktiver Konten (siehe
  // app/api/cron/cleanup/route.ts) - Admin-Konten sind davon ausgenommen.
  lastLoginAt  DateTime @default(now())

  // Einladung UND Passwort-Reset teilen sich denselben Mechanismus: ein einmaliger,
  // befristeter Link. Gespeichert wird nur der SHA-256-Hash des Tokens, damit ein
  // Datenbank-Leak keine gültigen Links preisgibt (siehe app/lib/auth.ts hashToken).
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  sessions          Session[]
  identities        ExternalIdentity[]
  pushSubscriptions PushSubscription[]
  ownedPolls        Poll[]             @relation("PollOwner")
  pollAccess        PollAccess[]
  liveSessions      LiveSession[]
  liveAccess        LiveAccess[]
}

// Server-seitige Session: das Cookie trägt nur den zufälligen Token, in der Datenbank
// liegt ausschließlich dessen SHA-256-Hash - ein Leak der Datenbank ergibt also keine
// übernehmbaren Sitzungen.
model Session {
  id                String             @id @default(cuid())
  tokenHash         String             @unique
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  pushSubscriptions PushSubscription[]

  @@index([userId])
}

// Web-Push-Abo eines Geräts (siehe app/lib/push.ts). Hängt an der SITZUNG, nicht nur am Konto:
// Wer sich auf einem Gerät abmeldet (oder dessen Sitzung abläuft), bekommt dort auch keine
// Mitteilungen mehr - wichtig auf geteilten Geräten. endpoint ist die Adresse beim Push-Dienst
// des Browsers (Google, Mozilla, Apple), p256dh/auth die Schlüssel, mit denen jede Nachricht
// Ende-zu-Ende verschlüsselt wird - der Push-Dienst sieht den Inhalt nicht.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Verknüpfung eines lokalen Kontos mit einem Konto in einem anderen Tool der Suite
// (siehe suite-kit). Identität ist (issuer, subject) - NIE die E-Mail, die sich beim
// Anbieter ändern lässt. issuer = Origin des Anbieter-Tools, subject = dessen Konto-ID.
model ExternalIdentity {
  id        String   @id @default(cuid())
  issuer    String
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issuer, subject])
  @@index([userId])
}

// Gemeinsames Moderieren: gibt einem Konto Zugriff auf eine fremde Abstimmung
// (bearbeiten, schließen - NICHT löschen oder weiter teilen, das bleibt beim Owner/Admin).
model PollAccess {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([userId])
}

// Zähler gegen Passwort-Raten und Mail-Flut (siehe app/lib/throttle.ts). `key` ist ein
// SHA-256-Hash aus Bereich + Kennung (E-Mail bzw. IP-Adresse) - es werden also weder
// Adressen noch IPs im Klartext gespeichert. Zeilen werden nach Ablauf des Zeitfensters
// bei Gelegenheit wieder gelöscht.
model LoginThrottle {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Eine Abstimmung mit beliebig vielen Optionen (siehe PollOption). Angelegt wird sie
// von einem eingeloggten Konto (ownerId), Stimmabgabe ist standardmäßig komplett
// anonym (siehe Vote.voterKey, Modus COOKIE) - dafür braucht niemand ein Konto.
//
// creatorToken/creatorEmail sind der ältere, kontolose Verwaltungslink: Er gilt NUR
// noch für Abstimmungen ohne ownerId (vor Einführung der Konten angelegt) und wird
// ignoriert, sobald ein Konto die Abstimmung besitzt (siehe app/lib/permissions.ts).
// Ein Konto kann eine solche Alt-Abstimmung mit dem Token übernehmen (claimPoll), dabei
// wird der Token erneuert, sodass alte Links wertlos werden.
//
// voterIdentity: wie eine Stimme einer Person zugeordnet wird (siehe VoterIdentity und
// app/lib/voter-identity.ts). Standard ist das anonyme Browser-Cookie; RSVP schaltet für
// GENAU DIESE Abstimmung auf eine über rsvp-app verifizierte E-Mail um (siehe
// app/lib/rsvp-verification.ts) - damit ist "eine Stimme pro echter Person" statt nur
// "eine Stimme pro Browser" möglich, kostet aber die Offenheit für Leute ohne passende
// Identität: Wer sie nicht hat, kann bewusst NICHT abstimmen - kein Cookie-Fallback,
// sonst wäre die Garantie wertlos. Lässt sich nur ändern, solange noch keine Stimme
// abgegeben wurde (siehe updatePoll), damit nie Stimmen verschiedener Arten gemischt werden.
//
// allowMultipleChoices: erlaubt pro Stimmabgabe mehrere Optionen gleichzeitig
// (Checkboxen statt Radiobuttons, siehe app/[pollId]/page.tsx) - unabhängig von
// voterIdentity wählbar, betrifft nur wie viele Optionen EINE Stimmabgabe
// umfassen darf, nicht die Identität dahinter. Technisch ändert das nichts an
// castVote's "Stimmen dieser Identität für diesen Poll ersetzen"-Logik (siehe dort) -
// bei false wird dabei serverseitig auf höchstens eine Option gekappt.
model Poll {
  id                       String            @id @default(cuid())
  title                    String
  description              String?
  // Besitzendes Konto. null nur bei Alt-Abstimmungen aus der Zeit ohne Konten (dort
  // gilt weiter creatorToken). Wird beim Löschen eines Kontos vorher umgehängt (siehe
  // deleteUser), die SetNull-Regel ist nur das Sicherheitsnetz.
  ownerId                  String?
  owner                    User?             @relation("PollOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  access                   PollAccess[]
  creatorToken             String            @unique @default(uuid())
  // Nur noch bei Alt-Abstimmungen befüllt (früher: Verwaltungs-Link per Mail). Neue
  // Abstimmungen schreiben dieses Feld nicht mehr - die E-Mail des Kontos genügt.
  creatorEmail             String?
  voterIdentity            VoterIdentity     @default(COOKIE)
  // Zeigt auf der öffentlichen Ergebnisseite zusätzlich, WER für welche Option gestimmt
  // hat (Vote.voterName), statt nur der aggregierten Zahlen - siehe [pollId]/page.tsx. Hat
  // nur bei Stimmen mit Namen eine sichtbare Wirkung (im Cookie-Modus nur mit requireVoterName).
  showVoterNames           Boolean           @default(false)
  // Wird NICHT beim Anlegen gesetzt, sondern beiläufig aus dem ersten empfangenen
  // rsvp-webhook (app/api/rsvp-webhook/route.ts) übernommen, sobald jemand über
  // rsvp-app für diese Abstimmung antwortet - siehe dort. Nötig, um bei Schließung zu
  // wissen, welchem rsvp-app-Event das Ergebnis gemeldet werden soll (siehe
  // app/lib/rsvp-notify.ts). Bleibt null, solange rsvp-app nie einen Webhook für diese
  // Abstimmung geschickt hat (z.B. weil der Modus RSVP nie genutzt wurde).
  rsvpEventId              String?
  allowMultipleChoices     Boolean           @default(false)
  // Nur im Modus COOKIE: Wer abstimmt, muss einen Namen angeben (Vote.voterName). Keine
  // echte Identität - nur soziale Kontrolle, zusammen mit showVoterNames sichtbar.
  requireVoterName         Boolean           @default(false)
  // Höchstzahl an Teilnehmenden (verschiedene voterKeys). Wer schon abgestimmt hat, kann
  // seine Auswahl weiter ändern; neue Personen werden abgewiesen. null = unbegrenzt.
  maxVoters                Int?
  // Optionaler Zugangscode, mit jedem Modus kombinierbar: Ohne ihn sieht man weder
  // Optionen noch Ergebnis und kann nicht abstimmen. Hält Fremde fern, verhindert aber
  // KEINE Mehrfachabstimmung (alle Berechtigten kennen denselben Code). Im Klartext
  // gespeichert, weil die Verwaltung ihn zum Weitergeben wieder anzeigen muss - er ist ein
  // geteiltes Merkwort, kein Passwort. Siehe app/lib/access-code.ts.
  accessCode               String?
  // Nur im Modus LINK: "nur Teilnahme speichern, nicht wer was gewählt hat" (geheime Wahl).
  // Die Stimme hängt dann an einem Schlüssel, der sich nur aus dem Link-Token ableiten lässt
  // (den die Datenbank nie sieht), am VoterLink steht nur hasVoted - siehe
  // app/lib/voter-links.ts. Gesperrt, sobald abgestimmt wurde (wie voterIdentity).
  secretBallot             Boolean           @default(false)
  // Nur im Modus EMAIL: wer sich bestätigen darf, eine Angabe pro Zeile - "@verein.de" für
  // eine ganze Domain, sonst eine einzelne Adresse. null = jede Adresse. Siehe
  // app/lib/email-voters.ts; wird auch beim Abstimmen erneut geprüft.
  allowedEmails            String?
  // Mindestbeteiligung: Das Ergebnis gilt erst ab so vielen Teilnehmenden (verschiedene
  // voterKeys), sonst "nicht beschlussfähig" (siehe app/lib/results.ts). null = kein Quorum.
  quorum                   Int?
  // Beim Schließen (manuell oder per Cron) das Ergebnis dem besitzenden Konto mitteilen
  // (Mail bzw. Push, app/lib/poll-closed.ts). Nur mit SMTP_HOST bzw. VAPID_* wirksam.
  notifyOwnerOnClose       Boolean           @default(false)
  // Wann die öffentliche Seite das Ergebnis zeigt (siehe ResultsVisibility). Die Verwaltung
  // sieht es immer.
  resultsVisibility        ResultsVisibility @default(ALWAYS)
  // Nur bei allowMultipleChoices: wie viele Optionen eine Stimmabgabe mindestens/höchstens
  // umfassen muss ("wähle 1 bis 3"). null = keine Grenze. Geprüft in castVote.
  minChoices               Int?
  maxChoices               Int?
  // Art der Optionen: Freitext oder Termine (siehe OptionKind). Steht nach dem Anlegen fest.
  optionKind               OptionKind        @default(TEXT)
  // Terminabstimmung (nur bei optionKind DATE/DATETIME): Nach dem Ende legt die Verwaltung
  // den Termin fest - bei eindeutigem Ergebnis bestätigen, bei Gleichstand zwischen den
  // gleichauf liegenden wählen, nie vollautomatisch (app/lib/final-date.ts). Danach werden
  // die erreichbaren Abstimmenden benachrichtigt und der Termin an rsvp-app übergeben
  // (app/lib/rsvp-date.ts).
  confirmDate              Boolean           @default(false)
  // Ergebnis der Festlegung: gewählte Option, endgültiger Zeitpunkt (bei Tagen mit der
  // dabei angegebenen Uhrzeit) und wann. finalizedAt ist zugleich die Sperre gegen doppeltes
  // Festlegen (bedingtes Update).
  finalOptionId            String?
  finalStartsAt            DateTime?
  finalizedAt              DateTime?
  // Was bei der Übergabe an rsvp-app herauskam (JSON, siehe RsvpTransfer in
  // app/lib/rsvp-date.ts) - für die Anzeige und "erneut übertragen". null = nicht versucht.
  rsvpTransfer             String?
  // Art der Abstimmung (siehe PollType). Gesperrt, sobald abgestimmt wurde - die
  // gespeicherten Vote.value-Werte bedeuten je Art etwas anderes.
  pollType                 PollType          @default(CHOICE)
  // Nur bei POINTS: so viele Punkte verteilt jede Person (höchstens).
  pointsBudget             Int?
  // Teilnehmende dürfen Optionen vorschlagen (app/actions.ts suggestOption); bei
  // voterOptionsNeedApproval erst sichtbar, wenn die Verwaltung sie freigibt (PollOption.approved).
  allowVoterOptions        Boolean           @default(false)
  voterOptionsNeedApproval Boolean           @default(true)
  closesAt                 DateTime?
  closedAt                 DateTime?
  createdAt                DateTime          @default(now())
  options                  PollOption[]
  votes                    Vote[]
  voterLinks               VoterLink[]
  emailVoters              EmailVoter[]

  @@index([ownerId])
}

// Persönlicher Stimmlink (Modus LINK): /[pollId]?k=<token>, eine Person pro Link. Wie bei
// Sessions und Einladungen liegt nur der SHA-256-Hash des Tokens in der Datenbank - ein
// Datenbank-Leak ergibt keine benutzbaren Links, dafür zeigt die Verwaltung einen Link nur
// direkt nach dem Ausstellen an (danach nur noch "neu ausstellen", das den alten ungültig
// macht und die bisherige Stimme behält). Siehe app/lib/voter-links.ts.
//
// label ist der Name der Person (oder "Link 3", wenn nur eine Anzahl gewünscht war), email
// nur gesetzt, wenn der Link per Mail verschickt werden soll. hasVoted ist bewusst ein
// Boolean ohne Zeitpunkt: Bei secretBallot soll sich eine Stimme nicht über gleiche
// Zeitstempel einem Link zuordnen lassen.
model VoterLink {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  label     String
  email     String?
  hasVoted  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([pollId])
}

// Bestätigte E-Mail-Adresse (Modus EMAIL, siehe app/lib/email-voters.ts). Jede Anfrage legt
// eine Zeile an und verschickt einen Einmal-Link (tokenHash, nur als SHA-256-Hash, befristet).
// Die Bestätigung selbst ist ein Knopfdruck auf der Link-Seite (kein reiner Aufruf - sonst
// würden Mail-Scanner, die Links vorab öffnen, den Link verbrauchen); danach ist tokenHash
// leer und der Browser hält ein Cookie, dessen Hash in sessionHash steht.
model EmailVoter {
  id             String    @id @default(cuid())
  pollId         String
  poll           Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  email          String
  tokenHash      String?   @unique
  tokenExpiresAt DateTime
  sessionHash    String?   @unique
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([pollId])
}

model PollOption {
  id       String    @id @default(cuid())
  pollId   String
  poll     Poll      @relation(fields: [pollId], references: [id])
  label    String
  position Int
  // Nur bei Terminoptionen (Poll.optionKind DATE/DATETIME), sonst null.
  startsAt DateTime?
  // false = Vorschlag von Teilnehmenden, der noch auf Freigabe wartet. Solche Optionen zählen
  // NIRGENDS als Option (Abstimmen, Ergebnis, Export, Bearbeiten) - nur die Verwaltungsseite
  // zeigt sie zum Freigeben oder Ablehnen.
  approved Boolean   @default(true)
  votes    Vote[]
}

// Wann die öffentliche Abstimmungsseite das Ergebnis zeigt (Poll.resultsVisibility):
// ALWAYS live, AFTER_VOTE erst nach der eigenen Stimme (oder nach dem Ende), AFTER_CLOSE erst
// nach dem Ende, MANAGERS nie öffentlich - dann geht es auch nicht an rsvp-app (siehe
// app/lib/rsvp-notify.ts), dort stünde es sonst auf der Event-Seite.
// Art der Optionen (Poll.optionKind): TEXT frei, DATE ein Tag, DATETIME Tag mit Uhrzeit.
// Bei Terminen trägt jede Option zusätzlich startsAt (Grundlage für die Sortierung und die
// geplante Übergabe des Gewinner-Termins an rsvp-app); label ist daraus formatiert, siehe
// app/lib/date-options.ts.
// Art der Abstimmung (Poll.pollType) und was Vote.value dabei bedeutet (siehe
// app/lib/poll-types.ts für Eingabe und app/lib/results.ts für die Auswertung):
// - CHOICE:       Auswahl (Einzel- oder Mehrfach, allowMultipleChoices), value = 1
// - YES_MAYBE_NO: pro Option Ja (2) / Vielleicht (1) / Nein (0), Doodle-Stil
// - RANKING:      Rangfolge, value = Platz (1 = am liebsten), Auswertung nach Borda
// - POINTS:       Punkte verteilen (höchstens Poll.pointsBudget), value = Punkte
enum PollType {
  CHOICE
  YES_MAYBE_NO
  RANKING
  POINTS
}

enum OptionKind {
  TEXT
  DATE
  DATETIME
}

enum ResultsVisibility {
  ALWAYS
  AFTER_VOTE
  AFTER_CLOSE
  MANAGERS
}

// Wie eine Stimme einer Person zugeordnet wird (Poll.voterIdentity, Vote.identityKind).
// Alle Arten sind umgesetzt (siehe app/lib/voter-identity.ts): COOKIE, LINK (persönlicher
// Stimmlink), EMAIL (per Mail bestätigte Adresse), ACCOUNT (Konto) und RSVP.
enum VoterIdentity {
  COOKIE
  LINK
  EMAIL
  ACCOUNT
  RSVP
}

// Eine Stimme ist EIN (Identität, Option)-Paar - bei einer Mehrfachauswahl-Abstimmung
// (Poll.allowMultipleChoices) entstehen für eine Stimmabgabe entsprechend mehrere
// Vote-Zeilen, eine pro gewählter Option, alle mit demselben voterKey.
//
// voterKey ist die aufgelöste Identität, IMMER mit der Art als Präfix (z.B.
// "cookie:<zufälliger Token>" oder "rsvp:<verifizierte E-Mail>", siehe voterKey() in
// app/lib/voter-identity.ts) - so können Schlüssel verschiedener Arten nie kollidieren.
// identityKind wiederholt die Art als eigene Spalte, damit man ohne String-Zerlegung
// danach filtern kann. voterName ist, was bei Poll.showVoterNames bzw. auf der
// Verwaltungsseite angezeigt wird (im Cookie-Modus nur mit Poll.requireVoterName).
//
// castVote (app/actions.ts) behandelt eine Stimmabgabe immer als "ersetze die
// komplette Auswahl dieser Identität für diesen Poll" - überschreibt/löscht also
// nicht mehr aktuelle Zeilen und legt die neu gewählten an, statt sie zu duplizieren,
// damit man seine Wahl jederzeit ändern kann, solange die Abstimmung offen ist.
// Bekannte, bewusst in Kauf genommene Grenze der Cookie-Variante: Wer Cookies löscht
// oder ein anderes Gerät nutzt, kann erneut abstimmen - für den vorgesehenen Rahmen
// (kleine, vertraute Gruppe) ein akzeptierter Kompromiss, kein Sicherheitsversprechen
// für öffentliche Abstimmungen mit Fremden. Genau diese Lücke schließen die anderen Arten.
//
// Umzug der Bestandsdaten aus dem früheren Modell (voterToken/verifiedEmail,
// Poll.requireRsvpVerification): scripts/migrate-db.js, läuft vor jedem `db push`.
model Vote {
  id           String        @id @default(cuid())
  pollId       String
  poll         Poll          @relation(fields: [pollId], references: [id])
  optionId     String
  option       PollOption    @relation(fields: [optionId], references: [id])
  identityKind VoterIdentity
  voterKey     String
  voterName    String?
  // Bedeutung je Poll.pollType (siehe PollType): 1 bei CHOICE, sonst Antwort, Platz oder Punkte.
  value        Int           @default(1)
  createdAt    DateTime      @default(now())

  @@unique([pollId, voterKey, optionId])
}

// ---------------------------------------------------------------------------------------
// Live-Runde (wie Kahoot, siehe app/lib/live.ts und README "Live-Runden"): eine Folge von
// Fragen, die die Verwaltung im Raum Frage für Frage vorführt (Präsentationsansicht), während
// die Teilnehmenden ohne Konto per PIN und Spitzname beitreten und auf dem Handy antworten.
// Bewusst getrennt von Poll: andere Identität (Spitzname pro Runde statt Stimmmodi), ein
// gemeinsamer Takt statt "abstimmen, solange offen", Fragen statt Optionen.

// Wo die Runde gerade steht. Weiter schaltet nur die Verwaltung - außer QUESTION -> REVEAL,
// das auch Zeitablauf oder "alle haben geantwortet" auslösen (app/lib/live.ts settleQuestion).
// LEADERBOARD gibt es nur nach Quizfragen (mit richtiger Antwort).
enum LivePhase {
  LOBBY
  QUESTION
  REVEAL
  LEADERBOARD
  FINISHED
}

model LiveSession {
  id                String         @id @default(cuid())
  title             String
  ownerId           String
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // 6-stellige Beitritts-PIN, nur solange die Runde läuft (null nach dem Ende und nach langer
  // Untätigkeit, siehe Cleanup-Cron) - so bleibt der Zahlenraum frei und alte PINs führen nirgends hin.
  pin               String?        @unique
  phase             LivePhase      @default(LOBBY)
  // Index (LiveQuestion.position) der aktuellen Frage, -1 in der Lobby.
  currentIndex      Int            @default(-1)
  questionStartedAt DateTime?
  // Ende des Zeitlimits der aktuellen Frage, null = ohne Zeitlimit (die Verwaltung löst auf).
  questionEndsAt    DateTime?
  // Kein Beitritt mehr möglich (von der Verwaltung in der Lobby oder während des Spiels gesetzt).
  joinLocked        Boolean        @default(false)
  // Bild aufdecken (LiveQuestion.imageReveal): von Hand zusätzlich aufgedeckte Stücke der aktuellen Frage.
  revealSteps       Int            @default(0)
  // Steigt bei jedem Zustandswechsel - daran erkennen die Ansichten beim Long-Polling eine Änderung.
  version           Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  startedAt         DateTime?
  finishedAt        DateTime?
  questions         LiveQuestion[]
  players           LivePlayer[]
  images            LiveImage[]
  access            LiveAccess[]

  @@index([ownerId])
}

// Gemeinsames Moderieren einer Live-Runde (wie PollAccess): Das Konto darf präsentieren,
// bearbeiten, neu starten und exportieren - NICHT löschen oder weiter teilen (siehe getLiveLevel).
model LiveAccess {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
}

// Art einer Frage (LiveQuestion.kind):
// - CHOICE:    eine Antwort wählen (Kahoot-Knöpfe); Quiz, wenn eine Antwort als richtig markiert ist
// - MULTI:     mehrere Antworten wählen; richtig nur bei genau der richtigen Kombination
// - ESTIMATE:  Zahl schätzen; Quiz, wenn `target` gesetzt ist (Punkte nach Nähe, siehe estimatePoints)
// - WORDCLOUD: kurzer Freitext, Wortwolke auf der Leinwand; nie Punkte
enum LiveQuestionKind {
  CHOICE
  MULTI
  ESTIMATE
  WORDCLOUD
  // Freitext: Antwort eintippen; mit eingetragenen richtigen Antworten (LiveAnswer, alle isCorrect) ein Quiz.
  TEXT
}

// Bild zu einer Frage. Bewusst in der Datenbank statt im Dateisystem: So ist es in der täglichen
// Sicherung enthalten und verschwindet mit der Runde. Gehört der Runde (nicht der Frage), weil
// "Bearbeiten" die Fragen neu anlegt und die Bilder dabei behalten soll. Im Browser verkleinert
// und neu kodiert (entfernt EXIF/GPS), serverseitig auf Typ und Größe geprüft (app/lib/live-images.ts).
model LiveImage {
  id        String         @id @default(cuid())
  sessionId String
  session   LiveSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  data      Bytes
  createdAt DateTime       @default(now())
  questions LiveQuestion[]

  @@index([sessionId])
}

model LiveQuestion {
  id          String           @id @default(cuid())
  sessionId   String
  session     LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position    Int
  text        String
  // Sekunden, null = ohne Zeitlimit.
  timeLimit   Int?
  kind        LiveQuestionKind @default(CHOICE)
  // Nur ESTIMATE: richtiger Wert (null = reine Umfrage), Toleranz für Punkte (null = 10 % des
  // Werts, mindestens 1) und eine Einheit zur Anzeige.
  target      Float?
  tolerance   Float?
  unit        String?
  imageId     String?
  image       LiveImage?       @relation(fields: [imageId], references: [id], onDelete: SetNull)
  // Bild wird auf der Leinwand Stück für Stück aufgedeckt (Promi/Ort erraten), auf den Handys erst
  // ab der Auflösung gezeigt (app/lib/live.ts revealedTiles).
  imageReveal Boolean          @default(false)
  answers     LiveAnswer[]
  responses   LiveResponse[]

  @@unique([sessionId, position])
}

// Eine Antwortmöglichkeit. Ist bei einer Frage mindestens eine als richtig markiert, ist sie
// eine Quizfrage (Punkte, Rangliste), sonst eine reine Umfragefrage.
model LiveAnswer {
  id         String         @id @default(cuid())
  questionId String
  question   LiveQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  label      String
  isCorrect  Boolean        @default(false)
  responses  LiveResponse[]
}

// Teilnehmende:r einer Runde. Kein Konto: Der Browser hält ein Cookie live_<sessionId> mit einem
// zufälligen Token, hier liegt nur dessen SHA-256-Hash. nicknameKey (klein geschrieben) macht den
// Spitznamen pro Runde eindeutig.
model LivePlayer {
  id          String         @id @default(cuid())
  sessionId   String
  session     LiveSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nickname    String
  nicknameKey String
  tokenHash   String         @unique
  createdAt   DateTime       @default(now())
  responses   LiveResponse[]

  @@unique([sessionId, nicknameKey])
}

// Eine Antwort pro Person und Frage (die erste zählt, wie bei Kahoot). elapsedMs = Zeit seit
// Fragebeginn laut Server, points = bei der Abgabe berechnete Punkte (0 bei Umfragefragen).
// Je nach LiveQuestion.kind ist genau eines gesetzt: answerId (CHOICE), choices (MULTI, JSON-Array
// der Antwort-IDs), numberValue (ESTIMATE) oder text/textKey (WORDCLOUD; textKey = klein
// geschrieben zum Zählen und Ausblenden, hidden = von der Leinwand ausgeblendet).
model LiveResponse {
  id          String       @id @default(cuid())
  questionId  String
  question    LiveQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  playerId    String
  player      LivePlayer   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  answerId    String?
  answer      LiveAnswer?  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  choices     String?
  numberValue Float?
  text        String?
  textKey     String?
  hidden      Boolean      @default(false)
  elapsedMs   Int
  points      Int          @default(0)
  createdAt   DateTime     @default(now())

  @@unique([questionId, playerId])
  @@index([playerId])
}

// ---------------------------------------------------------------------------------------
// Teilnehmendenkonto aus einem anderen Tool der Suite (suite-kit v0.2.0, Teilnehmenden-
// Bestätigung, z.B. ein GuestUser aus rsvp-app). Bewusst NICHT User/Session: Eine solche
// Anmeldung kann strukturell keine Verwaltungsrechte haben - sie taugt nur zum Abstimmen im
// Modus ACCOUNT (voterKey "participant:<id>", siehe app/lib/voter-identity.ts).
// Identität ist (issuer, subject); subject ist die PAARWEISE Kennung des Anbieters (nur dieses
// Tool sieht sie). Keine E-Mail - der Anbieter überträgt nur den Namen.
model Participant {
  id          String               @id @default(cuid())
  issuer      String
  subject     String
  name        String
  createdAt   DateTime             @default(now())
  // Zuletzt bei einer Anmeldung gesetzt - Grundlage der Löschfrist (2 Jahre, Cleanup-Cron).
  lastLoginAt DateTime             @default(now())
  sessions    ParticipantSession[]

  @@unique([issuer, subject])
}

// Sitzung eines Teilnehmendenkontos: eigenes Cookie (app/lib/participant.ts), nur der Hash in
// der Datenbank, bewusst KURZ (24 Stunden) - eine beim Anbieter gelöschte oder entzogene
// Anmeldung wirkt hier so spätestens nach einem Tag, ohne dass es einen Rückkanal braucht.
model ParticipantSession {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([participantId])
}
