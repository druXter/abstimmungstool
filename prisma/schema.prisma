// prisma/schema.prisma
// Kein eigener migrations-Ordner - wie bei rsvp-app ausschließlich per
// `npx prisma db push` synchronisiert (siehe README.md/Dockerfile).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Eine Abstimmung mit beliebig vielen Optionen (siehe PollOption). Bewusst ohne
// Nutzer-Konten: Anlegen ist nur mit der gemeinsamen CREATE_PIN möglich (siehe
// app/lib/create-pin.ts), Stimmabgabe ist standardmäßig komplett anonym (siehe
// Vote.voterToken). creatorToken ist der private Verwaltungslink (Abstimmung
// schließen/löschen) - gleiches Prinzip wie Participant.editToken in rsvp-app:
// Besitz des Tokens ist die einzige Berechtigung, es gibt keinen Login dafür.
//
// requireRsvpVerification: schaltet für GENAU DIESE Abstimmung von der anonymen
// Cookie-Identität auf eine über rsvp-app verifizierte E-Mail um (siehe
// app/lib/rsvp-verification.ts) - damit ist "eine Stimme pro echter Person" statt
// nur "eine Stimme pro Browser" möglich, kostet aber die Offenheit für Leute ohne
// RSVP-Konto: direkter/anonymer Zugriff kann dann bewusst NICHT abstimmen (siehe
// app/[pollId]/page.tsx) - kein unverifizierter Fallback, sonst wäre die Garantie
// wertlos. Rein additiv und pro Abstimmung einzeln gewählt, ändert nichts am
// Standardverhalten aller anderen (nicht so markierten) Abstimmungen.
//
// allowMultipleChoices: erlaubt pro Stimmabgabe mehrere Optionen gleichzeitig
// (Checkboxen statt Radiobuttons, siehe app/[pollId]/page.tsx) - unabhängig von
// requireRsvpVerification wählbar, betrifft nur wie viele Optionen EINE Stimmabgabe
// umfassen darf, nicht die Identität dahinter. Technisch ändert das nichts an
// castVote's "Stimmen dieser Identität für diesen Poll ersetzen"-Logik (siehe dort) -
// bei false wird dabei serverseitig auf höchstens eine Option gekappt.
model Poll {
  id                      String       @id @default(cuid())
  title                   String
  description             String?
  creatorToken            String       @unique @default(uuid())
  requireRsvpVerification Boolean      @default(false)
  allowMultipleChoices    Boolean      @default(false)
  closesAt                DateTime?
  closedAt                DateTime?
  createdAt               DateTime     @default(now())
  options                 PollOption[]
  votes                   Vote[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id])
  label    String
  position Int
  votes    Vote[]
}

// Eine Stimme ist EIN (Identität, Option)-Paar - bei einer Mehrfachauswahl-Abstimmung
// (Poll.allowMultipleChoices) entstehen für eine Stimmabgabe entsprechend mehrere
// Vote-Zeilen, eine pro gewählter Option, alle mit derselben Identität. Die Identität
// hängt entweder an einem zufälligen, im Browser gespeicherten voterToken-Cookie
// (siehe app/lib/voter.ts) ODER, bei Poll.requireRsvpVerification, an einer über
// rsvp-app verifizierten E-Mail (siehe app/lib/rsvp-verification.ts) - pro Poll gilt
// immer nur genau eine der beiden Spalten, nie beide gleichzeitig. Beide
// @@unique-Constraints greifen unabhängig voneinander - NULL-Werte kollidieren in
// SQLite nicht untereinander, daher stört die jeweils ungenutzte Spalte (durchgehend
// NULL) die Eindeutigkeit der anderen nie.
// castVote (app/actions.ts) behandelt eine Stimmabgabe immer als "ersetze die
// komplette Auswahl dieser Identität für diesen Poll" - überschreibt/löscht also
// nicht mehr aktuelle Zeilen und legt die neu gewählten an, statt sie zu duplizieren,
// damit man seine Wahl jederzeit ändern kann, solange die Abstimmung offen ist.
// Bekannte, bewusst in Kauf genommene Grenze der Cookie-Variante: Wer Cookies löscht
// oder ein anderes Gerät nutzt, kann erneut abstimmen - für den vorgesehenen Rahmen
// (kleine, vertraute Gruppe) ein akzeptierter Kompromiss, kein Sicherheitsversprechen
// für öffentliche Abstimmungen mit Fremden. Genau diese Lücke schließt die
// verifizierte Variante, wo sie eingesetzt wird.
model Vote {
  id            String     @id @default(cuid())
  pollId        String
  poll          Poll       @relation(fields: [pollId], references: [id])
  optionId      String
  option        PollOption @relation(fields: [optionId], references: [id])
  voterToken    String?
  verifiedEmail String?
  createdAt     DateTime   @default(now())

  @@unique([pollId, voterToken, optionId])
  @@unique([pollId, verifiedEmail, optionId])
}
