DATABASE_URL="file:./dev.db"

# Basis-URL für generierte Links (Teilen-/Einladungs-/Reset-Link). In Produktion die
# echte, öffentlich erreichbare Domain eintragen (ohne abschließenden Slash). Sie ist
# zugleich die Kennung dieses Tools gegenüber anderen Tools der Suite (SUITE_*, unten) -
# muss also exakt der Adresse entsprechen, unter der die anderen Tools es erreichen.
BASE_URL=http://localhost:3000

# Wie viele Reverse Proxys (z.B. nginx-proxy) vor diesem Tool stehen. Bestimmt, welcher
# Eintrag von X-Forwarded-For als Besucher-IP für die Login-Drosselung gilt (von rechts
# gezählt - links steht Beliebiges, das der Client selbst mitschicken kann). 1 = ein
# Proxy. 0 = direkter Zugriff ohne Proxy (der Header wird dann komplett ignoriert und
# alle Besucher teilen sich EINEN Zähler - nur für lokale Entwicklung sinnvoll).
TRUST_PROXY_HOPS=1

# Impressum-Angaben (siehe app/impressum/page.tsx) - optional. Ohne diese Werte
# zeigt die Seite generische Platzhalter statt echter personenbezogener Daten an.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_ZIP=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=

# Gemeinsames Secret zur Prüfung von Verifizierungs-Tokens/Webhooks aus rsvp-app
# (siehe app/lib/rsvp-verification.ts) - nur relevant für Abstimmungen mit
# requireRsvpVerification. MUSS exakt mit POLL_VERIFICATION_SECRET in der .env von
# rsvp-app übereinstimmen. Generieren z.B. mit: openssl rand -hex 32
RSVP_VERIFICATION_SECRET=

# Basis-URL von rsvp-app für die aktive Ergebnis-Meldung beim Schließen einer
# Abstimmung (siehe app/lib/rsvp-notify.ts). Ohne Wert bleibt diese Meldung einfach
# aus, kein Fehler.
RSVP_APP_BASE_URL=

# Für den automatischen Schließen-Cronjob (app/api/cron/close-expired-polls),
# von einem externen Scheduler (z.B. Uptime Kuma) periodisch mit ?secret=...
# aufgerufen. Generieren z.B. mit: openssl rand -hex 24
CRON_SECRET=

# SMTP-Zugangsdaten für Einladungs- und Passwort-Reset-Mails (siehe app/lib/mail.ts) -
# optional: ohne SMTP_HOST funktioniert alles weiter, der Einladungslink wird dem
# einladenden Konto dann auf dem Bildschirm angezeigt und Passwort-Reset per Mail ist
# nicht möglich. Können identisch mit den SMTP_*-Werten von rsvp-app sein, falls beide
# Tools denselben Mail-Provider/AVV nutzen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Abstimmungstool <deine-email@domain.de>"

# --- Konto-Verbund mit anderen Tools der Suite (optional, siehe README "Konten") -------
# Ohne diese Werte arbeitet das Tool nur mit eigenen lokalen Konten - es gibt dann nicht
# einmal einen Login-Button für andere Tools.

# Anzeigename dieses Tools auf den Login-Buttons anderer Tools.
SUITE_APP_NAME="Abstimmungstool"

# ANBIETER-Seite: Privater Signierschlüssel dieses Tools. Erzeugen mit:
#   node node_modules/suite-kit/bin/suite-keygen.js
# Geheim halten - er verlässt dieses Tool nie. Der öffentliche Teil wird automatisch unter
# /.well-known/suite-identity veröffentlicht. Leer = dieses Tool stellt keine Logins für
# andere Tools aus.
SUITE_SIGNING_KEY=
# Nur während einer Schlüsselrotation: der bisherige Schlüssel, damit noch gültige
# Bestätigungen weiter prüfbar bleiben (2 Minuten reichen).
SUITE_SIGNING_KEY_PREVIOUS=

# ANBIETER-Seite: Kommagetrennte Origins der Tools, die Logins von hier empfangen dürfen,
# z.B. https://rsvp.deine-domain.de,https://plaetze.deine-domain.de
SUITE_TRUSTED_APPS=

# EMPFÄNGER-Seite: Tools, mit deren Konten man sich hier anmelden darf. Entweder Origins
# kommagetrennt (https://rsvp.deine-domain.de) oder JSON für Einzeleinstellungen:
#   [{"issuer":"https://rsvp.deine-domain.de","label":"rsvp-app","autoProvision":true,"mapAdminRole":false}]
# autoProvision: erster Login legt automatisch ein Konto ohne Passwort an (Standard: true).
# mapAdminRole:  Admins des anderen Tools werden hier ebenfalls Admin (Standard: false,
#                sonst Creator; Moderatoren bleiben Moderatoren).
SUITE_IDPS=
