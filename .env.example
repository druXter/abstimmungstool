DATABASE_URL="file:./dev.db"

# Basis-URL für generierte Links (Teilen-/Verwaltungs-Link). In Produktion die
# echte, öffentlich erreichbare Domain eintragen (ohne abschließenden Slash).
BASE_URL=http://localhost:3000

# Gemeinsamer Zugangscode zum ANLEGEN neuer Abstimmungen - schützt NICHT das
# Abstimmen selbst, das bleibt für jeden mit einem Link offen. Leer lassen, um das
# Anlegen komplett offen zu lassen (z.B. für rein lokalen/vertrauten Einsatz).
CREATE_PIN=

# Impressum-Angaben (siehe app/impressum/page.tsx) - optional. Ohne diese Werte
# zeigt die Seite generische Platzhalter statt echter personenbezogener Daten an.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_ZIP=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=

# Gemeinsames Secret zur Prüfung von Verifizierungs-Tokens/Webhooks aus rsvp-app
# (siehe app/lib/rsvp-verification.ts) - nur relevant für Abstimmungen mit
# requireRsvpVerification. MUSS exakt mit POLL_VERIFICATION_SECRET in der .env von
# rsvp-app übereinstimmen. Generieren z.B. mit: openssl rand -hex 32
RSVP_VERIFICATION_SECRET=

# Basis-URL von rsvp-app für die aktive Ergebnis-Meldung beim Schließen einer
# Abstimmung (siehe app/lib/rsvp-notify.ts). Ohne Wert bleibt diese Meldung einfach
# aus, kein Fehler.
RSVP_APP_BASE_URL=

# Für den automatischen Schließen-Cronjob (app/api/cron/close-expired-polls),
# von einem externen Scheduler (z.B. Uptime Kuma) periodisch mit ?secret=...
# aufgerufen. Generieren z.B. mit: openssl rand -hex 24
CRON_SECRET=

# SMTP-Zugangsdaten für den optionalen Mailversand des Verwaltungs-Links beim
# Anlegen (siehe app/lib/mail.ts, Poll.creatorEmail) - komplett optional, ohne
# SMTP_HOST bleibt dieses Feature einfach inaktiv (kein Fehler). Können identisch
# mit den SMTP_*-Werten von rsvp-app sein, falls beide Tools denselben Mail-
# Provider/AVV nutzen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Abstimmungstool <deine-email@domain.de>"
